# URL base de la API Laravel 12 (sin barra final)
BASE_URL=http://localhost:8000/api/v1

# Clave pública de Stripe (Modo de prueba) para inicializar Stripe Elements en el cliente
# IMPORTANTE: Nunca colocar aquí la clave secreta (sk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_key_university_ecommerce

# Secreto para la firma interna del intercambio efímero de cookies (Opcional, tiene fallback seguro)
AUTH_EXCHANGE_SECRET=internal_super_secure_vault_secret_change_in_production
